					"foot_right_rotate_2_1.ty": "cos(limb_swing*1.5)*limb_speed*3.5",
					"foot_right_rotate_2_2.rx": "sin(limb_swing*1.5)*limb_speed*1.5",
					"foot_left_idle_1.rz": "cos(time*0.1)*0.1",
					"foot_left_idle_2.rz": "cos(time*0.1)*0.1",
					"foot_right_idle_1.rz": "cos(time*0.1)*0.1",
					"foot_right_idle_2.rz": "cos(time*0.1)*0.1",
					"torso_idle_1.tx": "sin(time*0.1)*0.5",
					"torso_idle_2.rz": "cos(time*0.1)*0.1",
					"floral_head.rz": "-sin(time*0.1)*0.1",
					"floral_head.rx": "torad(head_pitch)*1",
					"floral_head.ry": "torad(head_yaw)*1",
					"flower.rz": "sin(time*0.1)*0.2"
				}
			]
